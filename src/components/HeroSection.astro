---
import { Image } from "astro:assets";
import profileImage from "@/assets/img/profile-pic.png";
import { FlipWordsComponent } from "@/components/react/flip-words-component";
import { BackgroundGradientDemo } from "@/components/react/background-gradient-component";
---

<section id="home">
  <div class="container">
    <div class="hero-content animate-on-scroll">
      <div class="hero-text">
        <h1>TIMOTHY CHIN</h1>
        <h2>
          <FlipWordsComponent client:load />
          <p>
            Passionate software engineer with expertise in Mobile App and Web
            Development. Wildly commited to producing high-quality, clean and
            maintainable code, as I have seen first-hand the detrimental effects
            of not doing so.
            <br />
            <br />
            Also dabbling in the latest frontier technologies; AI and Web3, as I am
            curious about the applications of decentralized applications, tokenization
            and increasingly intelligent LLMs in revolutionizing the future.
          </p>
        </h2>
      </div>
      <div class="profile-image">
        <BackgroundGradientDemo client:load />
      </div>
    </div>
  </div>
</section>
